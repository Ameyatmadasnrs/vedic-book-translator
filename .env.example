# ==============================================================================
# Vedic Book Translator - Environment Configuration Template
# Copy this file to .env and fill in the required API keys.
# NEVER commit .env to version control!
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO

# AI Provider API Keys (Configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local / Self-Hosted Model Endpoints (Optional: Ollama / vLLM / LM Studio)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3:latest

# Default AI Provider & Models
DEFAULT_TRANSLATION_PROVIDER=gemini
DEFAULT_TRANSLATION_MODEL=gemini-2.5-pro
DEFAULT_PHILOSOPHICAL_REVIEW_MODEL=claude-3-7-sonnet-20250219
DEFAULT_LITERARY_POLISH_MODEL=gpt-4o

# Translation Storage & Memory
DATABASE_URL=sqlite:///./data/vedic_translator.db
TRANSLATION_MEMORY_STORE=./data/translation_memory.jsonl
CHECKPOINT_DIR=./data/checkpoints

# OCR Configuration (Tesseract / EasyOCR)
TESSERACT_CMD=
TESSERACT_LANGUAGES=san+rus+eng

# Publishing Engine Fonts
DEVANAGARI_FONT_PATH=
CYRILLIC_FONT_PATH=
